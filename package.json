{
  "name": "convertitore-unita",
  "version": "2.0.0",
  "private": true,
  "description": "API di conversione delle unità di misura",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "prepare": "husky",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  }
}
